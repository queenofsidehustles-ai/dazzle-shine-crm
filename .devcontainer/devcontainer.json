{
  "name": "Akye (Python 3.12 + Postgres 16)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteEnv": {
    "TEST_POSTGRES_URL": "postgresql+psycopg2://postgres:postgres@localhost:5432/akye_full_suite",
    "PGURL": "postgresql+psycopg2://postgres:postgres@localhost:5432/akye_full_suite",
    "PGOPTIONS": "-c log_min_messages=fatal -c log_min_error_statement=panic"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
